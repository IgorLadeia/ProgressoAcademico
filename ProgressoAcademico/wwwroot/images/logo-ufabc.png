<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Background circle -->
  <circle cx="100" cy="100" r="95" fill="none" stroke="#2f6b45" stroke-width="2"/>
  
  <!-- Green gradient definition -->
  <defs>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2f6b45;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#163e2f;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="yellowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f2b400;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e8a800;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Main logo shape - U -->
  <path d="M 50 50 L 50 140 Q 50 160 70 160 L 130 160 Q 150 160 150 140 L 150 50" 
        fill="none" stroke="url(#greenGrad)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Yellow accent bar -->
  <rect x="50" y="35" width="100" height="6" rx="3" fill="url(#yellowGrad)"/>
  
  <!-- Center accent -->
  <circle cx="100" cy="100" r="8" fill="#f2b400" opacity="0.8"/>
</svg>