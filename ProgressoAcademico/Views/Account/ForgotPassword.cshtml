@model ProgressoAcademico.ViewModels.ForgotPasswordViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Recuperar senha";
}

<div class="page-bg">
    <div class="login-card">
        <div class="login-left">
            <header class="brand">
                <img src="~/images/ufabc-logo.png" alt="UFABC Logo" class="brand-logo" />
                <nav class="brand-nav" aria-label="Main navigation">
                    <a href="/" aria-current="false">Home</a>
                    <a href="#" aria-current="false">Sobre</a>
                    <a href="#" aria-current="false">Contato</a>
                    <a href="/Account/Login" aria-current="false">Login</a>
                </nav>
            </header>

            <main class="form-area" role="main" aria-labelledby="forgot-title">
                <h1 id="forgot-title">Recuperar senha</h1>
                <p>Digite seu e-mail institucional para receber instruções de redefinição.</p>

                <form method="post" asp-action="ForgotPassword" class="login-form" autocomplete="on">
                    @Html.AntiForgeryToken()

                    <div class="input-group">
                        <label for="Email" class="sr-only">E-mail</label>
                        <div class="input-with-icon">
                            <span class="icon" aria-hidden="true">📧</span>
                            <input id="Email" name="Email" type="email" placeholder="seu@exemplo.edu.br"
                                   value="@Model?.Email" required />
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                    </div>

                    <button class="btn-primary" type="submit">Enviar</button>

                    <div class="divider"><span>ou</span></div>

                    <p class="register-link"><a href="/Account/Login">Voltar ao login</a></p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="validation-summary success" role="status" aria-live="polite">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-summary" role="alert" aria-live="polite">
                            @Html.ValidationSummary()
                        </div>
                    }
                </form>
            </main>
        </div>

        <aside class="login-right" aria-hidden="false">
            <div class="right-card">
                <div class="right-header">
                    <div class="megaphone" aria-hidden="true">🔐</div>
                    <h3>Esqueceu sua senha?</h3>
                </div>

                <p class="right-sub">Não se preocupe, vamos ajudar você a recuperar o acesso.</p>

                <ul class="tips">
                    <li>Use sempre o e-mail cadastrado no sistema</li>
                    <li>Verifique a caixa de spam se não achar o e-mail</li>
                </ul>

                <a class="all-dates" href="/">Voltar à página inicial</a>
            </div>
        </aside>

    </div>
</div>
