<header class="auth-header">
    <div class="header-left">
        <img src="~/images/logo-ufabc.png" alt="UFABC" class="logo" />
    </div>

    <div class="header-right">
        <div class="user-info">
            <img src="~/images/user-default.png" class="user-avatar" />
            <div>
                <strong>@ViewBag.UserName</strong><br />
                <span class="user-role">@ViewBag.UserRole</span>
            </div>
        </div>

        <div class="user-menu">
            <a asp-controller="Account" asp-action="Edit">Meus Dados</a>
            <a asp-controller="Account" asp-action="Logout">Sair</a>
        </div>
    </div>
</header>
